{
  "name": "dsh-style-wallpaper",
  "version": "1.0.0",
  "type": "module",
  "description": "Customize the DSH top-left name and logo, and use an image as the window wallpaper.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "wallpaper",
    "branding",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shshy250/dsh-style.git"
  },
  "homepage": "https://github.com/shshy250/dsh-style#readme",
  "bugs": {
    "url": "https://github.com/shshy250/dsh-style/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
